              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a contact list"
        },
        {
          "info": {
            "name": "Bulk add or remove contacts in a list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mailjet.com/v3.1/contactslist/:id/managemanycontacts",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk add or remove contacts in a list"
