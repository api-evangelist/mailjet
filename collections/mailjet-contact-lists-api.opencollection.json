          },
          "http": {
            "method": "POST",
            "url": "https://api.mailjet.com/v3.1/contactslist",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a contact list"
        },
        {
          "info": {
            "name": "Get a contact list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mailjet.com/v3.1/contactslist/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a contact list"
        },
        {
          "info": {
            "name": "Delete a contact list",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
