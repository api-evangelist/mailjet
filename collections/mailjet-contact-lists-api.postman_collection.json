  "info": {
    "_postman_id": "55e5ccd4-c395-4960-bcbd-ffee3f0eb938",
    "name": "Mailjet Email Campaigns Contact Lists API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Mailjet Email API enables sending transactional and marketing emails programmatically via JSON requests. The API also exposes resources for managing contacts, contact lists, segments, campaigns, templates, sender addresses, statistics, and event tracking. All requests use HTTP Basic authentication with an API key and secret pair issued from the Mailjet account dashboard.\n\nContact Support:\n Name: Mailjet API Support",
      "type": "text/plain"
    }
